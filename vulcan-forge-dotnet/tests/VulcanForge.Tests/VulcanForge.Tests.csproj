<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Alvo unico, e o mais novo: os testes rodam na maquina de quem desenvolve e no CI
      do proprio plugin, nunca dentro da imagem de um projeto consumidor. Multi-alvo
      aqui so dobraria o tempo sem cobrir risco nenhum.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>VulcanForge.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/VulcanForge.Cli/VulcanForge.Cli.csproj" />
  </ItemGroup>

</Project>
