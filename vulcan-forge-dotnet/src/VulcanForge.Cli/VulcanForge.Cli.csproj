<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!--
      MULTI-ALVO, e isso nao e zelo: a ferramenta roda DENTRO da imagem do SDK do
      job de CI, e uma imagem `sdk:8.0` traz so o runtime 8. Um pacote alvo unico
      em net10.0 nao rodaria la, e a falha seria na hora de publicar a imagem - o
      pior momento.

      Com os dois alvos, o `dotnet tool` escolhe o que couber na imagem em uso.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <!-- Empacota como ferramenta de linha de comando (`dotnet tool`). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vulcan-forge</ToolCommandName>
    <PackageId>dlduarte.VulcanForge.Cli</PackageId>
    <PackageTags>docker;oci;nexus;ci;publish</PackageTags>
    <!--
      COM ACENTO, ao contrario do resto do projeto: a regra de escrever sem acento vale
      para o texto que sai em log de terminal. A <Description> nao sai em terminal - ela
      e o resumo renderizado na pagina do pacote no NuGet.org.
    -->
    <Description>
      Publica imagem Docker (e pacote NuGet) a partir de um projeto .NET, gravando os
      rótulos da OCI. É o irmão .NET dos plugins Maven e Gradle do Vulcan Forge.
    </Description>

    <!--
      O README vai DENTRO do pacote: a pagina do NuGet.org so mostra a documentacao que
      o proprio .nupkg carrega - ela nao busca o README do repositorio. Sem isto, a
      pagina fica com o aviso "Your package is missing a README" e so a <Description>.
    -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <RootNamespace>VulcanForge</RootNamespace>
    <AssemblyName>vulcan-forge</AssemblyName>

    <!-- Os testes precisam alcancar as classes internas. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VulcanForge.Tests" />

    <!-- O README do lado .NET, na raiz do pacote, onde o <PackageReadmeFile> o procura. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
